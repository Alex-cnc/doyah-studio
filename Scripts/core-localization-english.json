{
  "note": "「Core 里写死的英文展示文案」白名单 + 棘轮（队列 L-109）。判据与用法见 Scripts/check-core-localization.py 头部（棘轮 B）。口径：**白名单之外一律报红；白名单只许缩小**（盘上已经没有的条目要销账，留着 = 那个串下次写回来会静默过关）。每条的 kind 只认脚本里那套词表；`unclassified` = 抄现状还没分类，**不在词表内 ⇒ 判红** —— 「加一条白名单」必须是一次有意识的分类决定，本文件的 --update-baseline-english 只抄现状、不替人分类。`displayDebt` = 确实直达界面、暂时写死英文的**已登记欠账**（不是放行）。",
  "kinds": {
    "sql": "SQL 方言片段 / 关键字 / 迁移 SQL —— 拼 SQL 用的，不是展示文案",
    "dbType": "数据库类型名（PG / MySQL 的类型原文）",
    "wireValue": "协议层取值字面量（如 PG 文本表示里的 `Infinity`）",
    "explainField": "PG `EXPLAIN` 输出或 JSON 的字段名 —— 解析用，不是展示文案",
    "driverMessage": "驱动 / 系统错误文本的**匹配子**（`contains` 用）",
    "serverMessageMatch": "服务端错误原文的匹配子 / 归类用",
    "internalErrorDescription": "内部错误描述的**机器载荷**（`LocalizedError` 的技术串；人话一律由带 `language:` 的渲染入口给 —— 概要设计 §7「协议入口不许写死语言」）",
    "protocolToken": "协议 / 接口层的固定串（HTTP 头名、认证方案、JSON-RPC 错误文本、SSL 模式名、MCP 方法名、剪贴板格式名）",
    "formatPattern": "日期 / 数字格式串",
    "pathName": "路径 / 目录名",
    "assetName": "字体 / 资源名",
    "xmlElementName": "XML 元素 / 属性名（xlsx OOXML）",
    "cliFlag": "命令行开关",
    "parseToken": "解析用户文本时要匹配的关键字（如维护计划里的 `cost: high`）",
    "logOnly": "只进日志",
    "guardrailPattern": "提示注入检测的模式串",
    "productName": "产品 / 品牌专名（按 R-53 同族口径不翻）",
    "sampleValue": "合成数据的样例值",
    "displayDebt": "**已登记的欠账**：确实直达界面、暂时写死英文 —— 不是放行，棘轮只挡变差"
  },
