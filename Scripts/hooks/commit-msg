#!/bin/sh
# Doyah Studio · 提交信息钩子：规范留痕（通用册第 6 条的机判）
#
# 为什么必须挂在 commit-msg 而不是 pre-commit：pre-commit 阶段 git 还没写这条提交的信息，
# 那时只能读到上一条 —— 用它判会假绿（上一条带留痕就放行）。
# 安装：bash Scripts/hooks/install.sh   绕过：git commit --no-verify（只在明确知道后果时用）
set -e
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$ROOT"
PY=""
for c in "${PYTHON:-}" "py -3" python python3; do
  [ -n "$c" ] || continue
  command -v $c >/dev/null 2>&1 || continue
  if [ "$($c -c 'import sys; print(sys.version_info[0])' 2>/dev/null)" = "3" ]; then PY="$c"; break; fi
done
[ -n "$PY" ] || { echo "[commit-msg] 找不到 Python 3，跳过留痕判据"; exit 0; }
$PY Scripts/action-router.py --trace-check "$1" || {
  echo "[commit-msg] ✗ 提交信息未通过留痕判据，提交已阻止。"
  exit 1
}
