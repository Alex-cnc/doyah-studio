{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Doyah Studio",
  "version": "0.3.0",
  "identifier": "studio.doyah.desktop.linux",
  "build": {
    "beforeDevCommand": "npm --prefix ../../windows/App run dev",
    "devUrl": "http://localhost:5274",
    "beforeBuildCommand": "npm --prefix ../../windows/App run build",
    "frontendDist": "../../windows/App/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Doyah Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: assethost:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
