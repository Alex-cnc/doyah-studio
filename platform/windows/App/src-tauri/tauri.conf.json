{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Doyah Studio",
  "version": "0.3.0",
  "identifier": "studio.doyah.desktop.windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5274",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Doyah Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: assethost:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "allowDowngrades": false
    }
  }
}
